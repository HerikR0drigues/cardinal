{
  "name": "cardinal",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Cardinal: comparador de cartões de crédito premium (monorepo: web, api e shared)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"npm run dev -w @cardinal/api\" \"npm run dev -w @cardinal/web\"",
    "dev:api": "npm run dev -w @cardinal/api",
    "dev:web": "npm run dev -w @cardinal/web",
    "db:migrate": "npm run db:migrate -w @cardinal/api",
    "db:seed": "npm run db:seed -w @cardinal/api",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "concurrently": "^10.0.6",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0"
  }
}
